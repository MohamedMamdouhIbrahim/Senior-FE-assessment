{
  "name": "fe-test-workspace",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/fe-test-workspace/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/fe-test-workspace",
        "browser": "apps/fe-test-workspace/src/main.ts",
        "tsConfig": "apps/fe-test-workspace/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/fe-test-workspace/public"
          },
          {
            "glob": "**/*",
            "input": "apps/fe-test-workspace/assets"
          },
          {
            "glob": "**/*",
            "input": "apps/fe-test-workspace/src/assets",
            "output": "/assets"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/src/lib/shared/icons",
            "output": "/assets/icons"
          }
        ],
        "styles": [
          "node_modules/bootstrap/dist/css/bootstrap.min.css",
          "apps/fe-test-workspace/src/styles.scss"
        ],
        "scripts": ["node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"],
        "server": "apps/fe-test-workspace/src/main.server.ts",
        "ssr": {
          "entry": "apps/fe-test-workspace/src/server.ts"
        },
        "outputMode": "server",
        "security": {
          "allowedHosts": []
        },
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/src/lib/shared/styles"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "fe-test-workspace:build:production"
        },
        "development": {
          "buildTarget": "fe-test-workspace:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "fe-test-workspace:build",
        "port": 4200,
        "staticFilePath": "dist/apps/fe-test-workspace/browser",
        "spa": true
      }
    }
  }
}
